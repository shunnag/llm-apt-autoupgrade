# /etc/aptai/env -- loaded by the systemd unit. Must be mode 0600, root-owned.
#
#   install -o root -g root -m 0600 /dev/null /etc/aptai/env
#   editor /etc/aptai/env
#
# This file is never read by the diagnostics collector and never uploaded.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: keep the webhook URLs out of the world-readable config file.
#APTAI_SLACK_WEBHOOK=https://hooks.slack.com/services/...
#APTAI_MATTERMOST_WEBHOOK=https://mattermost.example.com/hooks/...
